# ============================================================================
# Sentinel-X environment template
#
# Copy to .env for local development. In production NONE of the secret
# values below live in a file: they are provisioned by the secret store
# (Vault / AWS Secrets Manager / ExternalSecrets) into the pod environment —
# see deploy/k8s.yaml (envFrom: sentinel-x-secrets). The app validates this
# contract at boot and refuses to start in production when a required secret
# is missing or is an obvious placeholder.
# ============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Secrets (secret-store-managed in production) ---------------------------
# MySQL connection string. Required.
DATABASE_URL=mysql://root:password@localhost:3306/sentinelx
# Session signing secret, >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
# OAuth provider base URL (interactive login).
OAUTH_SERVER_URL=
# openId of the platform owner (bootstrap admin; permanent admin anchor).
OWNER_OPEN_ID=
VITE_APP_ID=

# --- Access control ---------------------------------------------------------
# Role assigned to a new user on first login: viewer | analyst | lead | admin.
# Defaults to 'analyst' (can investigate immediately). Set to 'viewer' for a
# least-privilege posture where an admin promotes explicitly. An invalid value
# degrades to 'analyst' with a warning.
DEFAULT_NEW_USER_ROLE=analyst

# --- Queue & rate limiting --------------------------------------------------
# Redis for the ingestion queue transport AND fleet-wide rate limiting.
# Unset → both degrade to per-pod in-memory mode (dev / single node only).
REDIS_URL=redis://localhost:6379
# Set "false" on API-only pods when running a dedicated worker Deployment.
INGEST_WORKER_ENABLED=true
INGEST_QUEUE_CONCURRENCY=4
INGEST_MAX_ATTEMPTS=3
INGEST_QUEUE_CAPACITY=1000
INGEST_STALE_AFTER_SECONDS=300
INGEST_REAPER_INTERVAL_SECONDS=60
INGEST_RETRY_DELAY_SECONDS=5
# Token bucket per authenticated user on ingestion routes.
INGEST_RATE_BURST=20
INGEST_RATE_PER_SECOND=5

# --- Database pool ----------------------------------------------------------
DB_POOL_SIZE=10
DB_POOL_QUEUE_LIMIT=200

# --- Notifications ----------------------------------------------------------
# Slack and webhook channels need no server config (targets are per-channel).
# Email channels require SMTP. Without these, email channels are skipped and
# the skip is recorded in the delivery ledger.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sentinel-x@your-domain.example
# Dispatch tuning (optional).
NOTIFY_TIMEOUT_MS=5000
NOTIFY_MAX_ATTEMPTS=2
NOTIFY_RETRY_DELAY_MS=400

# --- Threat-intel feeds -----------------------------------------------------
# Scheduled polling of admin-configured TAXII/STIX/MISP feeds. 0 disables the
# scheduler (manual "poll now" via the API still works).
INTEL_POLL_INTERVAL_MINUTES=0
INTEL_FETCH_TIMEOUT_MS=20000
